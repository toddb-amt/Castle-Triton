<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/id_page_receipt"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:background="#FFFFFF">

    <!-- Success/Failure Icon Area -->
    <TextView
        android:id="@+id/txvResultIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✓"
        android:textSize="80sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Result Message -->
    <TextView
        android:id="@+id/txvResultMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/txvResultIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Decline Reason Box - PROMINENT display for failed transactions -->
    <LinearLayout
        android:id="@+id/layoutDeclineReason"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:background="#FFEBEE"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/txvResultMessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txvDeclineReasonLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REASON"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#B71C1C"
            android:gravity="center"/>

        <TextView
            android:id="@+id/txvDeclineReasonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#D32F2F"
            android:gravity="center"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/txvDeclineCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#B71C1C"
            android:gravity="center"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

    <!-- Transaction Summary Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutSummary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/shape"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@+id/layoutDeclineReason"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Withdrawal Amount -->
        <TextView
            android:id="@+id/txvWithdrawalLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Withdrawal Amount:"
            android:textSize="16sp"
            android:textColor="#666666"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txvWithdrawalAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            app:layout_constraintTop_toTopOf="@+id/txvWithdrawalLabel"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Service Fee -->
        <TextView
            android:id="@+id/txvFeeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Service Fee:"
            android:textSize="16sp"
            android:textColor="#666666"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/txvWithdrawalLabel"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txvFeeAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            app:layout_constraintTop_toTopOf="@+id/txvFeeLabel"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Divider -->
        <View
            android:id="@+id/divider1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintTop_toBottomOf="@+id/txvFeeLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Total Amount -->
        <TextView
            android:id="@+id/txvTotalLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Charged:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/divider1"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txvTotalAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            app:layout_constraintTop_toTopOf="@+id/txvTotalLabel"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Card Info -->
        <TextView
            android:id="@+id/txvCardLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Card:"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/txvTotalLabel"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txvCardInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="****1234"
            android:textSize="14sp"
            android:textColor="#000000"
            app:layout_constraintTop_toTopOf="@+id/txvCardLabel"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Date/Time -->
        <TextView
            android:id="@+id/txvDateTimeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date/Time:"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/txvCardLabel"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txvDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2025/10/25 12:00:00"
            android:textSize="14sp"
            android:textColor="#000000"
            app:layout_constraintTop_toTopOf="@+id/txvDateTimeLabel"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Transaction ID -->
        <TextView
            android:id="@+id/txvTransactionIdLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transaction ID:"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/txvDateTimeLabel"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txvTransactionId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="TXN123456789"
            android:textSize="14sp"
            android:textColor="#000000"
            android:gravity="end"
            app:layout_constraintTop_toTopOf="@+id/txvTransactionIdLabel"
            app:layout_constraintStart_toEndOf="@+id/txvTransactionIdLabel"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="8dp"/>

        <!-- Authorization Code -->
        <TextView
            android:id="@+id/txvAuthCodeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auth Code:"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/txvTransactionIdLabel"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txvAuthCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@+id/txvAuthCodeLabel"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Reference Number -->
        <TextView
            android:id="@+id/txvRefNumberLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ref #:"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/txvAuthCodeLabel"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/txvRefNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#000000"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@+id/txvRefNumberLabel"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Response Message (shown on decline) -->
        <TextView
            android:id="@+id/txvResponseMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="#F44336"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/txvRefNumberLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Action Buttons - pinned to bottom -->
    <Button
        android:id="@+id/btnNewTransaction"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="New Transaction"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnDone"
        app:layout_constraintHorizontal_weight="1"/>

    <Button
        android:id="@+id/btnDone"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="Done"
        android:textSize="20sp"
        android:textStyle="bold"
        android:backgroundTint="@color/colorPrimary"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnNewTransaction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"/>

    <!-- Print Receipt Button - above action buttons -->
    <Button
        android:id="@+id/btnPrintReceipt"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Print Receipt"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/btnNewTransaction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
