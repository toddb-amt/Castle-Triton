<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/id_page_admin_atm"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:background="#FFFFFF">

    <!-- Header -->
    <TextView
        android:id="@+id/txvAdminTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="ATM Administration"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@+id/txvAdminTitle"
        app:layout_constraintBottom_toTopOf="@+id/btnExit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Fee Configuration Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fee Configuration"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <RadioGroup
                android:id="@+id/rgFeeType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <RadioButton
                    android:id="@+id/rbFlatFee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flat Fee"
                    android:textSize="16sp"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/rbPercentageFee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Percentage Fee"
                    android:textSize="16sp"/>
            </RadioGroup>

            <!-- Flat Fee Amount -->
            <LinearLayout
                android:id="@+id/layoutFlatFee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flat Fee Amount: $"
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtFlatFee"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="3.00"
                    android:textSize="16sp"/>
            </LinearLayout>

            <!-- Percentage Fee -->
            <LinearLayout
                android:id="@+id/layoutPercentageFee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Percentage Fee: "
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtPercentageFee"
                    android:layout_width="80dp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="0.0"
                    android:textSize="16sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" %"
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"/>

            <!-- Withdrawal Limits Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Withdrawal Limits"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <!-- Minimum Amount -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:text="Minimum Amount: $"
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtMinAmount"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="20.00"
                    android:textSize="16sp"/>
            </LinearLayout>

            <!-- Maximum Amount -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:text="Maximum Amount: $"
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtMaxAmount"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="500.00"
                    android:textSize="16sp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="16dp"/>

            <!-- Terminal Information Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terminal Information"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/txvTerminalInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Terminal: S1F4 PRO\nVersion: 1.0.0\nSerial: ATM-001"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="16dp"/>

            <!-- Host Settings Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Host Settings"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <!-- Processor Type -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Processor:"
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>

                <Spinner
                    android:id="@+id/spinnerProcessorType"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:spinnerMode="dropdown"/>
            </LinearLayout>

            <!-- Protocol Type -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Protocol:"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>

                <Spinner
                    android:id="@+id/spinnerProtocolType"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:spinnerMode="dropdown"/>
            </LinearLayout>

            <!-- Host Address -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Host Address:"
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtHostAddress"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:hint="e.g., atm.processor.com"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- Host Port -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Port:"
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtHostPort"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="8002"
                    android:textSize="16sp"/>

                <CheckBox
                    android:id="@+id/chkUseTls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TLS"
                    android:checked="true"
                    android:layout_marginStart="16dp"/>
            </LinearLayout>

            <!-- Terminal ID -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Terminal ID:"
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtTerminalId"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:hint="e.g., TERM001"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- Host Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <Button
                    android:id="@+id/btnTestConnection"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Test Connection"
                    android:textSize="14sp"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnDownloadKeys"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Download Keys"
                    android:textSize="14sp"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- Request New Working Key Button -->
            <Button
                android:id="@+id/btnRequestNewKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Request New Working Key"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#FF9800"/>

            <!-- Host Status -->
            <TextView
                android:id="@+id/txvHostStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Not Connected"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="16dp"/>

            <!-- Reversal Management Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reversal Management"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <!-- Pending Reversals Status -->
            <TextView
                android:id="@+id/txvReversalStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pending Reversals: 0"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="8dp"/>

            <!-- Process Reversals Button -->
            <Button
                android:id="@+id/btnProcessReversals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Process Pending Reversals"
                android:textSize="14sp"
                android:enabled="false"
                android:layout_marginBottom="8dp"/>

            <!-- Clear Reversals Button (use with caution) -->
            <Button
                android:id="@+id/btnClearReversals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clear All Pending (Caution!)"
                android:textSize="12sp"
                android:backgroundTint="#F44336"
                android:visibility="gone"
                android:layout_marginBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="16dp"/>

            <!-- Transaction History Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transaction History"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <!-- Transaction Statistics -->
            <TextView
                android:id="@+id/txvTransactionStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Transactions: 0"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="8dp"/>

            <!-- View History Button -->
            <Button
                android:id="@+id/btnViewHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View Transaction History"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <!-- Clear History Button -->
            <Button
                android:id="@+id/btnClearHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clear Transaction History"
                android:textSize="12sp"
                android:backgroundTint="#FF9800"
                android:visibility="gone"
                android:layout_marginBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="16dp"/>

            <!-- WiFi Configuration Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WiFi Configuration"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/txvWifiStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WiFi status: unknown"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:paddingBottom="8dp"/>

            <Button
                android:id="@+id/btnWifiScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan for Networks"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="SSID:"
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtWifiSsid"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:hint="Network name"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Password:"
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtWifiPassword"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:hint="Password"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Security:"
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>

                <Spinner
                    android:id="@+id/spinnerWifiSecurity"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:spinnerMode="dropdown"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnWifiConnect"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Connect WiFi"
                    android:textSize="16sp"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnWifiStatus"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Refresh Status"
                    android:textSize="16sp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="16dp"/>

            <!-- Diagnostics Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diagnostics"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <Button
                android:id="@+id/btnTestPrinter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Test Printer"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnTestCardReader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan Keys"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>

            <!-- Kiosk Mode Section -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kiosk Mode"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kiosk Mode (lock app, disable nav)"
                    android:textSize="14sp"/>

                <android.widget.Switch
                    android:id="@+id/switchKioskMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Auto-start on boot"
                    android:textSize="14sp"/>

                <android.widget.Switch
                    android:id="@+id/switchAutoStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Screen always on"
                    android:textSize="14sp"/>

                <android.widget.Switch
                    android:id="@+id/switchScreenAlwaysOn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Daily auto-reboot (3:00 AM)"
                    android:textSize="14sp"/>

                <android.widget.Switch
                    android:id="@+id/switchAutoReboot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnApplyKiosk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apply Kiosk Settings"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>

            <!-- ============ POS Mode (semi-integrated proxy) ============ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="POS MODE (semi-integrated)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="When enabled, this terminal also accepts transactions from the TFI proxy. Restart the app after changing these settings."
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginBottom="12dp"/>

            <CheckBox
                android:id="@+id/cbEnablePosMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable POS Mode"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Proxy URL"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>
            <EditText
                android:id="@+id/edtPosProxyUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="wss://proxy.myviewonline.com"
                android:inputType="textUri"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Terminal Access Key"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>
            <EditText
                android:id="@+id/edtPosAccessKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="from proxy admin portal"
                android:inputType="textPassword"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/txvPosStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="POS state: (not running)"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"/>

            <!-- Save Settings Button -->
            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Save Settings"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="@color/colorPrimary"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Exit Button -->
    <Button
        android:id="@+id/btnExit"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Exit Admin"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
