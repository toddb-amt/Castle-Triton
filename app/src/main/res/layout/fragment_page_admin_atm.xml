<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/id_page_admin_atm"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:background="#FFFFFF">

    <!-- Header -->
    <TextView
        android:id="@+id/txvAdminTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="ATM Administration"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@+id/txvAdminTitle"
        app:layout_constraintBottom_toTopOf="@+id/btnExit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Fee Configuration Section (CasHUB-managed, read-only since 6.2.9) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/hdrFeeConfig"
                android:text="Fee Configuration"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/txvFeeConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fee: —"
                android:textSize="16sp"
                android:textColor="#333333"
                android:paddingBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Managed centrally via CasHUB"
                android:textSize="12sp"
                android:textColor="#888888"
                android:paddingBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="16dp"/>

            <!-- Withdrawal Limits Section (CasHUB-managed, read-only since 6.2.9) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/hdrWithdrawal"
                android:text="Withdrawal Limits"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/txvLimits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Minimum: — · Maximum: —"
                android:textSize="16sp"
                android:textColor="#333333"
                android:paddingBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Managed centrally via CasHUB"
                android:textSize="12sp"
                android:textColor="#888888"
                android:paddingBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="16dp"/>

            <!-- Terminal Information Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/hdrTerminalInfo"
                android:text="Terminal Information"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/txvTerminalInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Terminal: S1F4 PRO\nVersion: 1.0.0\nSerial: ATM-001"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="16dp"/>

            <!-- Network Section (6.2.10): transport in use, SIM/carrier, APN, registration — read-only -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/hdrNetwork"
                android:text="Network"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/txvNetwork"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reading network state…"
                android:textSize="14sp"
                android:textColor="#333333"
                android:paddingBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="APN managed centrally via CasHUB (apn, apn_name, apn_user, apn_password, apn_auth_type, apn_protocol)"
                android:textSize="12sp"
                android:textColor="#888888"
                android:paddingBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="16dp"/>

            <!-- Reporting Section (6.2.13, RPT-02): MyView push status — read-only; Retry now for Super -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/hdrReporting"
                android:text="Reporting (MyView)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/txvReporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reporting: not configured"
                android:textSize="14sp"
                android:textColor="#333333"
                android:paddingBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Key and URL managed centrally via CasHUB (reporting_access_key, reporting_url)"
                android:textSize="12sp"
                android:textColor="#888888"
                android:paddingBottom="8dp"/>

            <Button
                android:id="@+id/btnReportingRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Retry now"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="16dp"/>

            <!-- Host Settings Section (CasHUB-managed, read-only since 6.2.9).
                 Shows the processor CODE (never its name) and the port — never the host
                 address. The only action left is Request New Working Key. -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/hdrHostSettings"
                android:text="Host Settings"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/txvHostConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Processor: — · Port —\nTerminal ID: —"
                android:textSize="16sp"
                android:textColor="#333333"
                android:paddingBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Managed centrally via CasHUB"
                android:textSize="12sp"
                android:textColor="#888888"
                android:paddingBottom="12dp"/>

            <!-- Request New Working Key Button (both admin tiers) -->
            <Button
                android:id="@+id/btnRequestNewKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Request New Working Key"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#FF9800"/>

            <!-- Host Status -->
            <TextView
                android:id="@+id/txvHostStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Not Connected"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="16dp"/>

            <!-- Reversal Management Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/hdrReversal"
                android:text="Reversal Management"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <!-- Pending Reversals Status -->
            <TextView
                android:id="@+id/txvReversalStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pending Reversals: 0"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="8dp"/>

            <!-- Process Reversals Button -->
            <Button
                android:id="@+id/btnProcessReversals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Process Pending Reversals"
                android:textSize="14sp"
                android:enabled="false"
                android:layout_marginBottom="8dp"/>

            <!-- Per-record diagnostics with Retry / Resolve (6.2.7). Populated by
                 Fragment_page_admin_atm.updateReversalStatus(); replaces "Clear All". -->
            <LinearLayout
                android:id="@+id/layReversalRecords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="16dp"/>

            <!-- Transaction History Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/hdrHistory"
                android:text="Transaction History"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <!-- Transaction Statistics -->
            <TextView
                android:id="@+id/txvTransactionStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Transactions: 0"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="8dp"/>

            <!-- View History Button -->
            <Button
                android:id="@+id/btnViewHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="View Transaction History"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <!-- Clear History Button -->
            <Button
                android:id="@+id/btnClearHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clear Transaction History"
                android:textSize="12sp"
                android:backgroundTint="#FF9800"
                android:layout_marginBottom="16dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="16dp"/>

            <!-- WiFi Configuration Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/hdrWifi"
                android:text="WiFi Configuration"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/txvWifiStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="WiFi status: unknown"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:paddingBottom="8dp"/>

            <Button
                android:id="@+id/btnWifiScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan for Networks"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="SSID:"
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtWifiSsid"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:hint="Network name"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Password:"
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>

                <EditText
                    android:id="@+id/edtWifiPassword"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:hint="Password"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="Security:"
                    android:textSize="16sp"
                    android:layout_gravity="center_vertical"/>

                <Spinner
                    android:id="@+id/spinnerWifiSecurity"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:spinnerMode="dropdown"/>
            </LinearLayout>

            <!-- Row 1: Connect WiFi + WiFi power toggle (6.2.10). Row 2: Refresh Status with a
                 spacer the width of the toggle, so both buttons are exactly the same size. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="4dp">

                <Button
                    android:id="@+id/btnWifiConnect"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Connect WiFi"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>

                <Switch
                    android:id="@+id/swWifiPower"
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"
                    android:text="WiFi"
                    android:textSize="14sp"
                    android:gravity="center_vertical"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <Button
                    android:id="@+id/btnWifiStatus"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Refresh Status"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>

                <View
                    android:layout_width="120dp"
                    android:layout_height="1dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="16dp"/>

            <!-- Diagnostics Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/hdrDiagnostics"
                android:text="Diagnostics"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <Button
                android:id="@+id/btnTestPrinter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Test Printer"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnTestCardReader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan Keys"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>

            <!-- Kiosk Mode Section -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/hdrKiosk"
                android:text="Kiosk Mode"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kiosk Mode (lock app, disable nav)"
                    android:textSize="14sp"/>

                <android.widget.Switch
                    android:id="@+id/switchKioskMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Auto-start on boot"
                    android:textSize="14sp"/>

                <android.widget.Switch
                    android:id="@+id/switchAutoStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Screen always on"
                    android:textSize="14sp"/>

                <android.widget.Switch
                    android:id="@+id/switchScreenAlwaysOn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Daily auto-reboot (3:00 AM)"
                    android:textSize="14sp"/>

                <android.widget.Switch
                    android:id="@+id/switchAutoReboot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnApplyKiosk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apply Kiosk Settings"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"/>

            <!-- ============ POS Mode (semi-integrated proxy) ============ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="POS MODE (semi-integrated)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="When enabled, this terminal also accepts transactions from the TFI proxy. Restart the app after changing these settings."
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginBottom="12dp"/>

            <CheckBox
                android:id="@+id/cbEnablePosMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable POS Mode"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Proxy URL"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>
            <EditText
                android:id="@+id/edtPosProxyUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="wss://proxy.myviewonline.com"
                android:inputType="textUri"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Terminal Access Key"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>
            <EditText
                android:id="@+id/edtPosAccessKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="from proxy admin portal"
                android:inputType="textPassword"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/txvPosStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="POS state: (not running)"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"/>

            <!-- Save Settings Button -->
            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Save Settings"
                android:textSize="18sp"
                android:textStyle="bold"
                android:backgroundTint="@color/colorPrimary"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Exit Button -->
    <Button
        android:id="@+id/btnExit"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="Exit Admin"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
