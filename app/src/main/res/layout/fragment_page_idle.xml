<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/id_page_idle"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#1565C0"
    android:clickable="true"
    android:focusable="true">

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- App Title -->
    <TextView
        android:id="@+id/txvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MyView"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <!-- Version -->
    <TextView
        android:id="@+id/txvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Version 1.0"
        android:textSize="16sp"
        android:textColor="#B3E5FC"
        android:layout_marginBottom="48dp" />

    <!-- Welcome Message -->
    <TextView
        android:id="@+id/txvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <!-- Call to Action -->
    <TextView
        android:id="@+id/txvTapToStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap Screen to Begin"
        android:textSize="20sp"
        android:textColor="#B3E5FC"
        android:layout_marginBottom="32dp" />

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Status/Info Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp">

        <!-- Connection Status -->
        <TextView
            android:id="@+id/txvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready"
            android:textSize="12sp"
            android:textColor="#81D4FA" />

    </LinearLayout>

</LinearLayout>
