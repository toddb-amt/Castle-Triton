<?xml version="1.0" encoding="utf-8"?>
<!-- TIP-01 (6.2.14): the tip screen, between the amount and the card phase.
     Same structure and button attributes as fragment_page_amount_selection.xml so the two screens match:
     a ConstraintLayout grid (no baseline alignment), 80dp presets, 70dp second row and Cancel. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/id_page_tip"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/txvTipTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Add a tip?"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/txvTipSale"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sale  $0.00"
        android:textSize="24sp"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@+id/txvTipTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Row 1: the three percentages, exactly the preset-button attributes -->
    <Button
        android:id="@+id/btnTip10"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:text="10%"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@+id/txvTipSale"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnTip15"
        app:layout_constraintHorizontal_weight="1"/>

    <Button
        android:id="@+id/btnTip15"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:text="15%"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@+id/btnTip10"
        app:layout_constraintStart_toEndOf="@+id/btnTip10"
        app:layout_constraintEnd_toStartOf="@+id/btnTip20"
        app:layout_constraintHorizontal_weight="1"/>

    <Button
        android:id="@+id/btnTip20"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:text="20%"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@+id/btnTip10"
        app:layout_constraintStart_toEndOf="@+id/btnTip15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"/>

    <!-- Reasons beneath greyed buttons ("Over $500.00 limit"); gone unless needed -->
    <TextView
        android:id="@+id/txvTip10Reason"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#D32F2F"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/btnTip10"
        app:layout_constraintStart_toStartOf="@+id/btnTip10"
        app:layout_constraintEnd_toEndOf="@+id/btnTip10"/>

    <TextView
        android:id="@+id/txvTip15Reason"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#D32F2F"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/btnTip15"
        app:layout_constraintStart_toStartOf="@+id/btnTip15"
        app:layout_constraintEnd_toEndOf="@+id/btnTip15"/>

    <TextView
        android:id="@+id/txvTip20Reason"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#D32F2F"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/btnTip20"
        app:layout_constraintStart_toStartOf="@+id/btnTip20"
        app:layout_constraintEnd_toEndOf="@+id/btnTip20"/>

    <!-- Row 2: Custom amount / No Tip, exactly the Custom Amount / Check Balance attributes -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierRow1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="btnTip10,btnTip15,btnTip20,txvTip10Reason,txvTip15Reason,txvTip20Reason"/>

    <Button
        android:id="@+id/btnTipCustom"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="Custom Amount"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@+id/barrierRow1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnNoTip"
        app:layout_constraintHorizontal_weight="1"/>

    <Button
        android:id="@+id/btnNoTip"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="No Tip"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@+id/btnTipCustom"
        app:layout_constraintStart_toEndOf="@+id/btnTipCustom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"/>

    <!-- Cancel at the bottom, the amount screen's Cancel attributes, full width (no Continue here: T9) -->
    <Button
        android:id="@+id/btnTipCancel"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:text="Cancel"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
