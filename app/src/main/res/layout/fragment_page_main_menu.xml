<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#FFFFFF">

    <!-- Hidden Admin Button - top right corner, small and inconspicuous -->
    <TextView
        android:id="@+id/btn_admin"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:text=""
        android:clickable="true"
        android:focusable="true" />

    <!-- Main content container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

    <!-- Spacer to push buttons toward center -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Withdrawal Button -->
    <Button
        android:id="@+id/btn_withdrawal"
        android:layout_width="300dp"
        android:layout_height="100dp"
        android:text="WITHDRAWAL"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="#4CAF50"
        android:layout_marginBottom="30dp"
        android:elevation="4dp" />

    <!-- Balance Inquiry Button -->
    <Button
        android:id="@+id/btn_balance_inquiry"
        android:layout_width="300dp"
        android:layout_height="100dp"
        android:text="BALANCE INQUIRY"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="#2196F3"
        android:elevation="4dp" />

    <!-- Spacer to push buttons toward center -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Hidden Host Totals button (kept for reference, not displayed) -->
    <Button
        android:id="@+id/btn_host_totals"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    </LinearLayout>

</RelativeLayout>
