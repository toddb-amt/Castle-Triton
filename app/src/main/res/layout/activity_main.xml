<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
                                                 xmlns:app="http://schemas.android.com/apk/res-auto"
                                                 xmlns:tools="http://schemas.android.com/tools"
                                                 android:id="@+id/main_content"
                                                 android:layout_width="match_parent"
                                                 android:layout_height="match_parent"
                                                 android:fitsSystemWindows="true"
                                                 tools:context="com.castech.emvl2_sampleap.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/appbar_padding_top"
        android:theme="@style/AppTheme.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="-6dp"

            android:background="?attr/colorPrimary"
            app:popupTheme="@style/AppTheme.PopupOverlay">

            <!-- Persistent status strip: WiFi signal + battery level/charging.
                 Right-aligned in the toolbar (left of the overflow menu),
                 updated from MainActivity. -->
            <LinearLayout
                android:id="@+id/statusStrip"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingEnd="6dp">

                <ImageView
                    android:id="@+id/imgSignalStatus"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_wifi_level"
                    android:contentDescription="Network signal" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:id="@+id/imgBatteryStatus"
                        android:layout_width="26dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_batt_level"
                        android:contentDescription="Battery level" />

                    <ImageView
                        android:id="@+id/imgCharging"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bolt"
                        android:visibility="gone"
                        android:contentDescription="Charging" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txvBatteryPct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="--%"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" >

        <Button
            android:id="@+id/btnWth"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Withdrawl"
            android:visibility="visible"
            tools:visibility="visible" />
    </androidx.viewpager.widget.ViewPager>

    <!--
        Persistent service banner, pinned to the bottom and drawn above the
        ViewPager so it stays visible on every screen. Currently used for the
        out-of-paper notice (receipt shown on screen instead). Hidden by default;
        toggled from MainActivity.updatePaperBanner().
    -->
    <TextView
        android:id="@+id/txvServiceBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#D32F2F"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp"
        android:elevation="8dp"
        android:visibility="gone"
        android:text="@string/banner_out_of_paper" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
